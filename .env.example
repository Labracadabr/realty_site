# Copy to .env and adjust. Values below are for LOCAL DEVELOPMENT only.

DEBUG=True
SECRET_KEY=dev-insecure-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_URL=http://localhost:8000

# SQLite for a zero-setup local run. For PostgreSQL:
# DATABASE_URL=postgres://lovinaland:lovinaland@localhost:5432/lovinaland
DATABASE_URL=sqlite:///db.sqlite3

# Admin panel path (keep it non-obvious in production)
ADMIN_URL=manage/

# Auto-translation. DeepL Free key ends with ":fx" (https://www.deepl.com/pro-api).
# Without a key the free MyMemory API is used (lower quality, daily limit).
DEEPL_API_KEY=

# Telegram lead notifications. Create a bot with @BotFather, get your chat id via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Test accounts created by `python manage.py seed_demo` (local only)
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=lovina-admin-dev
DEV_PARTNER_USERNAME=partner
DEV_PARTNER_PASSWORD=lovina-partner-dev
