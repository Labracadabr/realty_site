# Copy to .env on the server and fill in. Never commit the real file.
DEBUG=False
SECRET_KEY=CHANGE_ME_generate_a_long_random_string
ALLOWED_HOSTS=bali-islands.com,www.bali-islands.com
CSRF_TRUSTED_ORIGINS=https://bali-islands.com,https://www.bali-islands.com
# The site's one main address: the other www / non-www variant redirects here.
SITE_URL=https://www.bali-islands.com

# Non-obvious admin path, must end with /
ADMIN_URL=CHANGE_ME-office/

POSTGRES_PASSWORD=CHANGE_ME_generate_a_long_random_string
WEB_PORT=8010
MEDIA_DIR=/var/www/bali-islands/media

DEEPL_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
